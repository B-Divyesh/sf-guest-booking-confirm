{
  "name": "guest-booking-confirm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'DATABASE_URL=sqlite:./data/dev.db cargo run' 'vite --host 0.0.0.0'",
    "build": "vite build",
    "test": "vitest run && cargo test",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && cargo clippy -- -D warnings",
    "preview": "DATABASE_URL=sqlite:./data/preview.db cargo run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "concurrently": "9.2.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@azure/msal-browser": "4.18.0"
  }
}
